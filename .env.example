PORT=8000
# Set DATABASE_URL in hosted environments, or use the PG* variables below locally.
# DATABASE_URL=postgresql://user:password@host:5432/database
# WhatsApp international number in digits only, including country code.
WHATSAPP_NUMBER=918319482309
# Public HTTPS origin of the deployed site (required for production auth links).
PUBLIC_SITE_URL=https://example.com
# Google OAuth web application credentials. Register this exact redirect URI:
# https://example.com/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/api/google/callback
# Resend email verification sender. Verify the sender domain with Resend first.
RESEND_API_KEY=
EMAIL_FROM=Astro Alok Tripathi <accounts@example.com>
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace-with-your-postgres-password
PGDATABASE=Astrology
